::  /boom mark: error-wrapped grub content
::  stores [tang bask] where bask is [blot noun]
::
=,  format
|_  [err=tang =bask:tarball]
++  grow
  |%
  ++  noun  [err bask]
  ++  json
    ^-  ^json
    %-  pairs:enjs
    :~  :-  'error'
        a+(turn (flop err) |=(=tank s+(crip ~(ram re tank))))
        ['mark' s+(crip (spud (snoc path.p.bask name.p.bask)))]
        :-  'data'
        s+(truncate 2.048 ~(ram re (sell !>(q.bask))))
    ==
  ++  txt
    ^-  wain
    :*  (crip "mark: {(spud (snoc path.p.bask name.p.bask))}")
        (turn (flop err) |=(=tank (crip ~(ram re tank))))
    ==
  ++  mime
    ^-  ^mime
    [/application/json (as-octs:mimes:html (en:json:html json))]
  --
++  grab
  |%
  ++  noun  |=(n=* ;;([tang bask:tarball] n))
  --
++  truncate
  |=  [max=@ud t=tape]
  ^-  @t
  ?:  (lte (lent t) max)  (crip t)
  (crip (weld (scag max t) "..."))
--
